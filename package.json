{
  "name": "anime-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --mode mock",
    "dev:mock": "vite --mode mock",
    "dev:api": "vite --mode development",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "oxlint": "oxlint -c oxlintrc.json .",
    "test": "vitest run --mode mock",
    "test:watch": "vitest --mode mock",
    "test:ui": "vitest --ui --mode mock",
    "size": "size-limit",
    "postinstall": "husky"
  },
  "size-limit": [
    {
      "name": "app bundle (brotli)",
      "path": "dist/assets/*.js",
      "limit": "400 kB"
    }
  ],
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "@tanstack/vue-query": "^5.101.4",
    "@tanstack/vue-virtual": "^3.13.35",
    "@vueuse/core": "^14.4.0",
    "@vueuse/head": "^2.0.0",
    "@vueuse/integrations": "^14.4.0",
    "ace-builds": "^1.44.0",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "change-case": "^5.4.4",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "fuse.js": "^7.5.0",
    "markdown-it": "^14.3.0",
    "pinia": "^4.0.2",
    "primeicons": "^8.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.40",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^10.0.8",
    "vue-router": "^5.2.0",
    "vue3-ace-editor": "^2.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-app": "^13.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/vue-query-devtools": "^5.91.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "msw": "^2.15.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.3.8",
    "workbox-window": "^7.4.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
