{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn"],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "warn",
    "typescript/no-explicit-any": "error",
    "no-underscore-dangle": ["warn", { "allow": ["__APP_VERSION__"] }]
  },
  "ignorePatterns": [
    "dist",
    "dev-dist",
    "coverage",
    "node_modules",
    "public/mockServiceWorker.js"
  ]
}
